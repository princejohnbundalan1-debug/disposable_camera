# Application Configuration
PORT=3000
NODE_ENV=development
APP_NAME="Wedding Moments - Digital Disposable Camera"
APP_URL=http://localhost:3000

# Session Configuration
SESSION_SECRET=wedding_super_secret_session_key_2026_change_in_production

# MySQL Database Configuration (Local or Cloud e.g. TiDB / Aiven / PlanetScale)
# Can use discrete variables or a single DATABASE_URL:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wedding_disposable_camera
DB_SSL=false
# Or Connection URI:
# DATABASE_URL=mysql://username:password@host:port/database?ssl={"rejectUnauthorized":true}

# Storage Configuration
# Options: local | cloudinary | s3 | supabase
STORAGE_PROVIDER=local
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
UPLOAD_DIR=./storage/uploads
THUMBNAIL_DIR=./storage/thumbnails
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
