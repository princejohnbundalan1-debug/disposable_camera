<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22><text y=%2226%22 font-size=%2224%22>💍</text></svg>">
</head>
<body>
  <%- include('../../partials/header') %>
  <%- include('../../partials/flash') %>

  <main style="flex: 1; padding: 2.5rem 0;">
    <div class="container container-narrow">
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.25rem;">
          <div>
            <h1 style="font-size: 1.85rem;">Event Settings</h1>
            <p style="color: var(--color-muted);"><%= event.name %> (/e/<%= event.public_id %>)</p>
          </div>
          <a href="/admin/events/<%= event.public_id %>/qr" class="btn btn-secondary btn-sm">🖨️ Table QR</a>
        </div>

        <form action="/admin/events/<%= event.public_id %>/edit" method="POST">
          <div class="form-group">
            <label for="name" class="form-label">Event Name *</label>
            <input type="text" id="name" name="name" class="form-control" value="<%= event.name %>" required>
          </div>

          <div class="form-group">
            <label for="couple_names" class="form-label">Couple Names</label>
            <input type="text" id="couple_names" name="couple_names" class="form-control" value="<%= event.couple_names || '' %>">
          </div>

          <div class="form-group">
            <label for="event_date" class="form-label">Wedding Date</label>
            <input type="date" id="event_date" name="event_date" class="form-control" value="<%= event.event_date ? new Date(event.event_date).toISOString().split('T')[0] : '' %>">
          </div>

          <div class="form-group">
            <label for="description" class="form-label">Welcome Message for Guests</label>
            <textarea id="description" name="description" class="form-control"><%= event.description || '' %></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Theme Color Accent</label>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem;">
              <% Object.values(themes).forEach(theme => { %>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; padding: 0.5rem 0.9rem; border: 1.5px solid var(--color-border); border-radius: var(--radius-md);">
                  <input type="radio" name="theme_color" value="<%= theme.primary %>" <%= event.theme_color === theme.primary ? 'checked' : '' %>>
                  <span style="width: 18px; height: 18px; border-radius: 50%; background: <%= theme.primary %>; display: inline-block;"></span>
                  <span style="font-size: 0.9rem; font-weight: 500;"><%= theme.name %></span>
                </label>
              <% }) %>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Guest Upload Status</label>
            <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; background: var(--color-light); padding: 1rem; border-radius: var(--radius-md);">
              <input type="checkbox" id="toggleUploadsCheckbox" name="is_uploads_enabled" data-public-id="<%= event.public_id %>" <%= event.is_uploads_enabled ? 'checked' : '' %> style="width: 20px; height: 20px;">
              <div>
                <strong id="uploadStatusLabel"><%= event.is_uploads_enabled ? 'Guest uploads are currently OPEN' : 'Guest uploads are CLOSED' %></strong>
                <p style="font-size: 0.85rem; color: var(--color-muted); margin: 0;">Uncheck to temporarily pause new photo/video uploads during or after the wedding.</p>
              </div>
            </label>
          </div>

          <div class="form-group">
            <label for="privacy_mode" class="form-label">Privacy Mode</label>
            <select id="privacy_mode" name="privacy_mode" class="form-control">
              <option value="PUBLIC" <%= event.privacy_mode === 'PUBLIC' ? 'selected' : '' %>>Public (Standard QR Access)</option>
              <option value="PRIVATE" <%= event.privacy_mode === 'PRIVATE' ? 'selected' : '' %>>Private (Restricted Token)</option>
            </select>
          </div>

          <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <button type="submit" class="btn btn-primary btn-lg" style="flex: 1;">Save Changes</button>
            <a href="/admin/events" class="btn btn-secondary btn-lg">Back to Events</a>
          </div>
        </form>

        <hr style="margin: 3rem 0 2rem 0; border: none; border-top: 1px solid var(--color-border);">

        <!-- Danger Zone -->
        <div>
          <h3 style="color: var(--color-danger); font-size: 1.15rem; margin-bottom: 0.5rem;">Danger Zone</h3>
          <p style="color: var(--color-muted); font-size: 0.9rem; margin-bottom: 1rem;">Deleting this event will permanently remove all associated photos, videos, and guestbook wishes.</p>
          <form action="/admin/events/<%= event.public_id %>/delete" method="POST" onsubmit="return confirm('Are you completely sure you want to delete this event and all uploaded media? This action cannot be undone.');">
            <button type="submit" class="btn btn-danger">Delete This Wedding Event</button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
  <script src="/js/admin.js"></script>
</body>
</html>
