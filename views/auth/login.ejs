<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22><text y=%2226%22 font-size=%2224%22>💍</text></svg>">
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">
  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>

  <main style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 3rem 1.5rem;">
    <div class="card" style="max-width: 440px; width: 100%;">
      <div style="text-align: center; margin-bottom: 2rem;">
        <span style="font-size: 2.5rem;">💍</span>
        <h1 style="font-size: 1.85rem; margin-top: 0.5rem;">Organizer Login</h1>
        <p style="color: var(--color-muted); font-size: 0.95rem;">Access your wedding dashboard and media</p>
      </div>

      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="you@wedding.com" required autofocus>
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1.5rem;">
          Sign In to Dashboard →
        </button>
      </form>

      <div style="text-align: center; margin-top: 1.75rem; font-size: 0.9rem; color: var(--color-muted);">
        Don't have an event yet? <a href="/auth/register" style="font-weight: 600;">Create an Account</a>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
