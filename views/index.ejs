<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wedding Moments | Digital Disposable Camera for Modern Weddings</title>
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22><text y=%2226%22 font-size=%2224%22>💍</text></svg>">
</head>

<body>
  <%- include('partials/header') %>
    <%- include('partials/flash') %>

      <!-- Hero Section -->
      <section
        style="padding: 4.5rem 0 3.5rem 0; text-align: center; background: radial-gradient(circle at 50% 20%, #FAF6F0 0%, #FAF8F5 100%);">
        <div class="container container-narrow">
          <div
            style="display: inline-block; padding: 0.4rem 1.1rem; background: var(--color-primary-light); color: var(--color-primary-hover); border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem;">
            ✨ The Modern Digital Disposable Camera
          </div>

          <h1 style="margin-bottom: 1.25rem;">Capture Every Candid Wedding Angle Through Your Guests' Eyes</h1>
          <p
            style="font-size: 1.2rem; color: #555; margin-bottom: 2.25rem; max-width: 620px; margin-left: auto; margin-right: auto;">
            No apps to download. Guests simply scan your table QR code, take photos & videos through a retro digital
            camera viewfinder, and contribute to your live shared album.
          </p>

          <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/auth/register" class="btn btn-primary btn-lg">Create Your Wedding Event 💍</a>
            <a href="/e/demo-wedding" class="btn btn-outline btn-lg" style="background: white;">Try Live Guest Demo 📸</a>
            <a href="/auth/login" class="btn btn-secondary btn-lg">Organizer Login →</a>
          </div>
        </div>
      </section>

      <!-- How It Works Section -->
      <section
        style="padding: 4rem 0; background: var(--color-white); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
        <div class="container">
          <div style="text-align: center; margin-bottom: 3rem;">
            <h2>How It Works</h2>
            <p style="color: var(--color-muted);">Effortless setup for hosts, instant delight for wedding guests</p>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem;">
            <!-- Step 1 -->
            <div class="card" style="text-align: center; border-radius: var(--radius-lg);">
              <div style="font-size: 2.75rem; margin-bottom: 1rem;">1️⃣ 🖨️</div>
              <h3 style="margin-bottom: 0.5rem;">Print Your Table QR</h3>
              <p style="font-size: 0.95rem; color: #666;">
                Create your wedding event and print customized, luxury 4x6" table signs with a high-resolution QR code.
              </p>
            </div>

            <!-- Step 2 -->
            <div class="card" style="text-align: center; border-radius: var(--radius-lg);">
              <div style="font-size: 2.75rem; margin-bottom: 1rem;">2️⃣ 📸</div>
              <h3 style="margin-bottom: 0.5rem;">Guests Scan & Snap</h3>
              <p style="font-size: 0.95rem; color: #666;">
                Guests scan with their phone camera. Zero app install needed! They snap photos or record videos through
                a vintage camera HUD.
              </p>
            </div>

            <!-- Step 3 -->
            <div class="card" style="text-align: center; border-radius: var(--radius-lg);">
              <div style="font-size: 2.75rem; margin-bottom: 1rem;">3️⃣ 🖼️</div>
              <h3 style="margin-bottom: 0.5rem;">Shared Live Album</h3>
              <p style="font-size: 0.95rem; color: #666;">
                Every captured moment and heartfelt guestbook wish is pooled into a gorgeous real-time wedding album
                ready for instant one-click ZIP download.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Interactive Guest Experience Preview -->
      <section style="padding: 4rem 0;">
        <div class="container container-narrow" style="text-align: center;">
          <h2 style="margin-bottom: 1rem;">Designed for Mobile Simplicity</h2>
          <p style="color: var(--color-muted); margin-bottom: 2rem;">
            Big touch-friendly buttons, vintage shutter sounds, flashlight strobe simulation, and video recording right
            inside mobile Safari and Chrome. Click below to try the live demo:
          </p>

          <div
            style="background: #111813; border: 2px solid var(--color-primary); border-radius: 30px; padding: 2.5rem 1.5rem; color: white; box-shadow: var(--shadow-lg); max-width: 380px; margin: 0 auto; transition: transform 0.2s ease;">
            <div style="font-size: 1.6rem; margin-bottom: 0.25rem;">💍</div>
            <div style="font-family: var(--font-serif); font-size: 1.4rem; font-weight: 700; color: #F4EDE2;">Hannah &
              Juan</div>
            <div style="font-size: 0.8rem; letter-spacing: 0.15em; color: #A0A0A0; margin-bottom: 1.5rem;">OUR WEDDING •
              SEPTEMBER 01, 2026</div>

            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
              <a href="/e/demo-wedding"
                style="display: block; background: var(--color-primary); color: #111813; padding: 0.95rem; border-radius: 99px; font-weight: 700; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 14px rgba(197, 168, 128, 0.4); transition: transform 0.15s ease, filter 0.15s ease;"
                onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                📷 Open Disposable Camera
              </a>
              <a href="/e/demo-wedding"
                style="display: block; background: rgba(255,255,255,0.12); color: white; padding: 0.95rem; border-radius: 99px; font-weight: 600; font-size: 0.95rem; text-decoration: none; backdrop-filter: blur(8px); transition: background 0.15s ease, transform 0.15s ease;"
                onmouseover="this.style.background='rgba(255,255,255,0.2)'; this.style.transform='scale(1.02)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'; this.style.transform='scale(1)'">
                ⬆ Upload from Phone
              </a>
              <a href="/e/demo-wedding/album"
                style="display: block; background: rgba(255,255,255,0.12); color: white; padding: 0.95rem; border-radius: 99px; font-weight: 600; font-size: 0.95rem; text-decoration: none; backdrop-filter: blur(8px); transition: background 0.15s ease, transform 0.15s ease;"
                onmouseover="this.style.background='rgba(255,255,255,0.2)'; this.style.transform='scale(1.02)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'; this.style.transform='scale(1)'">
                🖼 View Live Album
              </a>
              <a href="/e/demo-wedding/guestbook"
                style="display: block; background: rgba(255,255,255,0.12); color: white; padding: 0.95rem; border-radius: 99px; font-weight: 600; font-size: 0.95rem; text-decoration: none; backdrop-filter: blur(8px); transition: background 0.15s ease, transform 0.15s ease;"
                onmouseover="this.style.background='rgba(255,255,255,0.2)'; this.style.transform='scale(1.02)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'; this.style.transform='scale(1)'">
                💌 Leave a Wish
              </a>
            </div>
          </div>
        </div>
      </section>

      <%- include('partials/footer') %>
</body>

</html>